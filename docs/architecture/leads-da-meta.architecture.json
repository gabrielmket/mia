    { "id": "e20", "from": "tela-config", "to": "rota-paginas", "label": "diagnóstico" },
    { "id": "e21", "from": "tela-config", "to": "rota-formularios", "label": "escolher destino" },
    { "id": "e22", "from": "tela-config", "to": "rota-ler-agora", "label": "Ler agora" },
    { "id": "e23", "from": "rota-paginas", "to": "graph-permissoes", "label": "permissões" },
    { "id": "e24", "from": "rota-paginas", "to": "graph-forms", "label": "formulários" },
    { "id": "e25", "from": "rota-estado", "to": "t-config", "label": "liga/desliga" },
