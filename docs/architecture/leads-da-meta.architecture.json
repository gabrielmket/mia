    { "id": "e5", "from": "rodada", "to": "graph-paginas", "label": "token da Página" },
    { "id": "e6", "from": "rodada", "to": "graph-leads", "label": "janela desde lido_ate" },
    { "id": "e7", "from": "rodada", "to": "gravar", "label": "cada lead" },
    { "id": "e8", "from": "gravar", "to": "t-recebidos", "label": "dedup" },
    { "id": "e9", "from": "gravar", "to": "create-lead", "label": "negócio" },
    { "id": "e10", "from": "gravar", "to": "captacao", "label": "formulário" },
    { "id": "e11", "from": "create-lead", "to": "t-contatos", "label": "grava" },
