{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Leads dos formulários da Meta (fork MIA, .60 a .62): do cadastro instantâneo ao funil",
    "subtitle": "Aviso em tempo real pelo webhook leadgen (.62) e consulta a cada 5 min como rede de segurança; os dois gravam pela mesma via da fonte de webhook. Plano em docs/fork/leads-da-meta.md",
    "output": "leads-da-meta.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "meta", "label": "Meta (Graph)" },
    { "id": "tela", "label": "Tela" },
    { "id": "api", "label": "Borda HTTP" },
    { "id": "rotina", "label": "Rotina" },
    { "id": "via", "label": "Via da fonte de webhook (upstream)" },
    { "id": "dados", "label": "Dados" },
    { "id": "retorno", "label": "Laço de retorno" }
  ],
  "mainPath": ["cron", "rodada", "graph-leads", "gravar", "create-lead", "captacao", "automacoes"],
  "nodes": [
    { "id": "graph-permissoes", "lane": "meta", "col": 0, "type": "service", "label": "me/permissions: o que o token tem" },
    { "id": "graph-paginas", "lane": "meta", "col": 1, "type": "service", "label": "me/accounts: Páginas e o token de cada uma" },
    { "id": "graph-forms", "lane": "meta", "col": 2, "type": "service", "label": "{pagina}/leadgen_forms: formulários e perguntas" },
    { "id": "graph-leads", "lane": "meta", "col": 3, "type": "service", "label": "{formulario}/leads por time_created (lib/plataformas-de-anuncio/meta/leads.ts)" },
    { "id": "graph-assinatura", "lane": "meta", "col": 4, "type": "service", "label": "{pagina}/subscribed_apps: a Página assinada no app para leadgen (.62)" },
    { "id": "graph-lead", "lane": "meta", "col": 5, "type": "service", "label": "{lead}: um lead pelo id que o aviso traz (.62)" },
    { "id": "meta-webhook", "lane": "meta", "col": 6, "type": "service", "label": "Webhook da Página, campo leadgen: o aviso em segundos (.62)" },

    { "id": "tela-config", "lane": "tela", "col": 0, "type": "ui", "label": "Configurações › Meta Ads › Formulários de leads (app/app/settings/meta-ads/_formularios.tsx), porta em lib/navigation/catalogo.ts" },
    { "id": "tela-historico", "lane": "tela", "col": 1, "type": "ui", "label": "Histórico de leituras: sucesso, sem novos, erro com o que fazer" },
    { "id": "tela-captacoes", "lane": "tela", "col": 2, "type": "ui", "label": "Captações (webhook_lead_captures) e card com etiqueta Meta_ads" },
    { "id": "central", "lane": "tela", "col": 3, "type": "ui", "label": "Central de avisos e push no celular dos administradores (.62)" },

    { "id": "rota-estado", "lane": "api", "col": 0, "type": "service", "label": "GET/PATCH /api/v1/leads-da-meta: estado e chave (admin muda)" },
    { "id": "rota-paginas", "lane": "api", "col": 1, "type": "service", "label": "GET /api/v1/leads-da-meta/paginas: diagnóstico do token" },
    { "id": "rota-formularios", "lane": "api", "col": 2, "type": "service", "label": "PUT /api/v1/leads-da-meta/formularios: destino conferido contra a empresa" },
    { "id": "rota-ler-agora", "lane": "api", "col": 3, "type": "service", "label": "POST /api/v1/leads-da-meta/ler-agora: a rodada só da empresa" },
    { "id": "rota-webhook", "lane": "api", "col": 4, "type": "service", "label": "GET/POST /api/v1/webhooks/leads-da-meta: HMAC com o App Secret da instalação (.62)" },

    { "id": "cron", "lane": "rotina", "col": 0, "type": "worker", "label": "cron leads-da-meta a cada 5 min (docker/scheduler/entrypoint.sh)" },
    { "id": "rodada", "lane": "rotina", "col": 1, "type": "worker", "label": "rodarLeadsDaMeta: janela desde a marca, do mais antigo ao mais novo" },
    { "id": "gravar", "lane": "rotina", "col": 2, "type": "logic", "label": "gravarLeadDaMeta: dedup por id (hash) e por pessoa; origem do anúncio" },
    { "id": "modulo", "lane": "rotina", "col": 3, "type": "logic", "label": "LEADS_DA_META_E_MODULO_VENDAVEL (lib/leads-da-meta/modulo.ts)" },
    { "id": "tempo-real", "lane": "rotina", "col": 4, "type": "worker", "label": "receberAvisoDeLead: dono da Página (9004), formulário ligado, mesma gravação (lib/leads-da-meta/tempo-real.ts)" },
    { "id": "campos", "lane": "rotina", "col": 5, "type": "logic", "label": "Telefone, nome e e-mail em pergunta própria, com escolha manual (campos-do-formulario.ts, .62)" },

    { "id": "create-lead", "lane": "via", "col": 0, "type": "service", "label": "createLeadHandler: negócio + lead.created" },
    { "id": "captacao", "lane": "via", "col": 1, "type": "service", "label": "registrarCaptacao: formulário com as perguntas originais" },
    { "id": "automacoes", "lane": "via", "col": 2, "type": "worker", "label": "event-log-drain / kickLocalPipeline: automações e follow-up de lead criado" },
    { "id": "ia-formulario", "lane": "via", "col": 3, "type": "logic", "label": "dados-do-formulario.ts: a IA sabe que a pessoa preencheu o formulário X" },

    { "id": "t-config", "lane": "dados", "col": 0, "type": "database", "label": "mia_leads_da_meta_config (chave por empresa)" },
    { "id": "t-formularios", "lane": "dados", "col": 1, "type": "database", "label": "mia_leads_da_meta_formularios (destino e marca lido_ate)" },
    { "id": "t-leituras", "lane": "dados", "col": 2, "type": "database", "label": "mia_leads_da_meta_leituras (histórico, podado em 30 dias)" },
    { "id": "t-recebidos", "lane": "dados", "col": 3, "type": "database", "label": "mia_leads_da_meta_recebidos (hash do id, podado em 120 dias)" },
    { "id": "t-contatos", "lane": "dados", "col": 4, "type": "database", "label": "contacts / crm_leads / webhook_lead_captures (dado pessoal, com LGPD)" },

    { "id": "laco-erro", "lane": "retorno", "col": 0, "type": "logic", "label": "Erro: a marca não anda; a próxima leitura relê a janela (até 90 dias)" },
    { "id": "laco-motivo", "lane": "retorno", "col": 1, "type": "logic", "label": "Motivo na tela diz a ação: token novo, permissão, Página, funil" },
    { "id": "aviso-falha", "lane": "retorno", "col": 2, "type": "logic", "label": "3 falhas seguidas: UM aviso por problema, fecha sozinho quando volta (aviso-de-falha.ts, .62)" }
  ],
  "edges": [
    { "id": "e1", "from": "cron", "to": "rodada", "label": "a cada 5 min" },
    { "id": "e2", "from": "rota-ler-agora", "to": "rodada", "label": "só a empresa, na hora" },
